{
  "manifest_version": 3,
  "name": "Av. Asistan — UYAP Senkron",
  "version": "0.8.0",
  "description": "UYAP Vatandaş Portalı'ndaki KENDİ dosyalarınızı, SİZ başlattığınızda panelinize aktarır. Otomatik/arka plan tarama yok.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://vatandas.uyap.gov.tr/*",
    "https://jzwsqvmyrbykcfeaanks.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Av. Asistan — UYAP Senkron"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vatandas.uyap.gov.tr/*"
      ],
      "js": [
        "uyap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
